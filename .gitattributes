* text=auto eol=lf
*.bat -text whitespace=blank-at-eol,blank-at-eof,cr-at-eol
*.jar binary
*.dex binary
*.apk binary
*.zip binary
tools/busybox binary
tools/cmd binary
tools/find binary
tools/jq binary
tools/keycheck binary
tools/smbclient binary
tools/speednative binary
tools/tar binary
tools/zstd binary

# Pinned upstream SHA manifests cover exact bytes.
tar/upstream/** -text
zstd/upstream/** -text
third_party/opencc-phrases/** -text -whitespace

# Imported sources/fixtures must retain their pinned upstream bytes.
# JSON tests deliberately contain trailing whitespace and malformed input.
rust/vendor/** -text -whitespace
tar/upstream/** -whitespace
zstd/upstream/** -whitespace
# These pinned Java sources end with an upstream blank line; still check line tails.
dex/app/src/main/java/hct/** whitespace=blank-at-eol,-blank-at-eof
dex/app/src/main/java/scheme/** whitespace=blank-at-eol,-blank-at-eof
dex/app/src/main/java/utils/** whitespace=blank-at-eol,-blank-at-eof
smb/baseline-overlay/third_party/waf/waflib/extras/gccdeps.py whitespace=blank-at-eol,-blank-at-eof
# Pinned Samba compatibility overlay; audited by baseline-overlay.json.
smb/baseline-overlay/** -whitespace
# Generated GNU Info separators resemble conflict markers; pinned SHA checks apply.
tar/upstream/doc/tar.info* -diff
