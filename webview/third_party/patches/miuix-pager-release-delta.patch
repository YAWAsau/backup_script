+    @Test
+    fun touchReleaseUsesConfiguredAnimationSpec() = runComposeUiTest {
+        lateinit var pager: PagerState
+        setContent {
+            pager = rememberPagerState { 3 }
+            val spec = androidx.compose.animation.core.tween<Float>(2000, easing = androidx.compose.animation.core.LinearEasing)
+            val fling = PagerDefaults.flingBehavior(pager, snapAnimationSpec = spec)
+            HorizontalPager(
+                state = pager,
+                modifier = Modifier.size(400.dp).testTag("custom-spec").pagerGestureOverride(pager, fling, snapAnimationSpec = spec),
+                userScrollEnabled = false,
+                pageNestedScrollConnection = PagerGestureNestedScrollConnection,
+            ) { Box(Modifier.fillMaxSize()) }
+        }
+        waitForIdle()
+        mainClock.autoAdvance = false
+        swipePage("custom-spec")
+        waitForIdle()
+        mainClock.advanceTimeBy(900)
+        waitForIdle()
+        assertTrue(pager.isScrollInProgress, "Touch release must use the supplied 2-second spec, not the Miuix spring")
+        finishAnimations()
+        assertEquals(1, pager.currentPage)
+        assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+    }
+
+    @Test
+    fun takeoverReleaseIncludesLastPointerDelta() = runComposeUiTest {
+        lateinit var pager: PagerState
+        lateinit var effect: MiuixOverscrollEffect
+        var claims = 0
+        setContent {
+            pager = rememberPagerState { 3 }
+            TestPager(pager, onTriggered = { claims++ }) { page ->
+                val overscroll = remember { MiuixOverscrollEffect() }
+                if (page == 0) effect = overscroll
+                LazyColumn(Modifier.fillMaxSize().testTag("release-list-$page"), overscrollEffect = overscroll) {
+                    items(20) { Box(Modifier.fillMaxWidth().height(60.dp)) }
+                }
+            }
+        }
+        waitForIdle()
+        mainClock.autoAdvance = false
+        onNodeWithTag("release-list-0").performTouchInput {
+            down(center)
+            repeat(5) { moveBy(Offset(0f, 16f), delayMillis = 16) }
+        }
+        waitForIdle()
+        onNodeWithTag("release-list-0").performTouchInput { up() }
+        advanceUntil { effect.isVerticallyRebounding }
+        onNodeWithTag("pager").performTouchInput {
+            down(Offset(width * 0.85f, centerY))
