+        }
+        waitForIdle()
+        assertEquals(1, claims, "This must exercise vertical rebound takeover")
+        onNodeWithTag("pager").performTouchInput {
+            advanceEventTime(200)
+            // Android may deliver the last coalesced displacement with ACTION_UP.
+            updatePointerTo(0, Offset(width * 0.10f, centerY))
+            up()
+        }
+        finishAnimations()
+        assertEquals(1, pager.currentPage, "Release displacement must count before choosing the destination")
+        assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+    }
